# Copy this file to ".env" and fill in your real values.
# The real .env file is ignored by git, so your secrets stay private.

# Get a free key at https://www.themoviedb.org/settings/api (use the "API Key (v3 auth)")
TMDB_API_KEY=your_api_key_here

DB_HOST=localhost
DB_PORT=5432
DB_NAME=movie_analytics
DB_USER=postgres
DB_PASSWORD=your_password
